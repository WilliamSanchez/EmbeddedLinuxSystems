/dts-v1/;
#include "am33xx.dtsi"
#include "am335x-bone-common.dtsi"
#include "am335x-boneblack-common.dtsi"
#include "am335x-boneblack-hdmi.dtsi"

//make ARCH=arm CROSS_COMPILE=arm-cortex_a8-linux-gnueabihf- dtbs

/*
		#define AM335X_PIN_LCD_DATA0			0x8a0
		#define AM335X_PIN_LCD_DATA1			0x8a4
		#define AM335X_PIN_LCD_DATA2			0x8a8
		#define AM335X_PIN_LCD_DATA3			0x8ac
		#define AM335X_PIN_LCD_DATA4			0x8b0
		#define AM335X_PIN_LCD_DATA5			0x8b4
		#define AM335X_PIN_LCD_DATA6			0x8b8
		#define AM335X_PIN_LCD_DATA7			0x8bc
		#define AM335X_PIN_LCD_DATA8			0x8c0
		#define AM335X_PIN_LCD_DATA9			0x8c4
		#define AM335X_PIN_LCD_DATA10			0x8c8
		#define AM335X_PIN_LCD_DATA11			0x8cc
		#define AM335X_PIN_LCD_DATA12			0x8d0
		#define AM335X_PIN_LCD_DATA13			0x8d4
		#define AM335X_PIN_LCD_DATA14			0x8d8
		#define AM335X_PIN_LCD_DATA15			0x8dc
		#define AM335X_PIN_LCD_VSYNC			0x8e0
		#define AM335X_PIN_LCD_HSYNC			0x8e4
		#define AM335X_PIN_LCD_PCLK				0x8e8
		#define AM335X_PIN_LCD_AC_BIAS_EN		0x8ec
*/

#include <dt-bindings/interrupt-controller/irq.h>

/ {
	model = "TI AM335x BeagleBone";
	compatible = "ti,am335x-bone", "ti,am33xx";
	
	pwm_servo {
		compatible	= "servo_motor,w_pwm_servo_motor";
		pwms 		= <&ehrpwm1 0 20000000 0>;
		pwm-names 	= "pwm_servo_motor";
		pinctrl-names	= "default";
		//pinctrl-0	= <&ehrpwm1_pins>;
		enabled		= <0>;
		duty		= <0>;
		status = "okay";				
	};
	
};

&am33xx_pinmux {

	pinctrl-name = "default";
	//pinctrl-0 = <&user_irq_led_default>;

	i2c1_pins: i2c1-pins {
		pinctrl-single,pins = <
			AM33XX_PADCONF(0x958, PIN_INPUT_PULLUP, MUX_MODE2)		/* spi0_d1.i2c2_sda 		P9_18*/
			AM33XX_PADCONF(0x95c, PIN_INPUT_PULLUP, MUX_MODE2)		/* spi0_cs0.i2c2_scl		P9_17*/

			AM33XX_IOPAD(0x8a0,PIN_INPUT_PULLDOWN | MUX_MODE7)		/* LCD_DATA0.gpio2_6		P8_45	|	PCLK	*/
			AM33XX_IOPAD(0x8a8,PIN_INPUT_PULLDOWN | MUX_MODE7) 		/* LCD_DATA2.gpio2_8 		P8_43	|	HSYNC	*/
			AM33XX_IOPAD(0x8b0,PIN_INPUT_PULLDOWN | MUX_MODE7)		/* LCD_DATA4.gpio2_10		P8_41	|	VSYNC 	*/

			/* AM33XX_IOPAD(0x894,PIN_OUTPUT_PULLDOWN | MUX_MODE7) 	*/		/* gpmc_oen_ren.gpio2_3 	P8_8*/
			/* AM33XX_IOPAD(0x890,PIN_INPUT_PULLDOWN | MUX_MODE7)	*/		/* gpmc_adv_ale.gpio2_2		P8_7*/
			/* AM33XX_IOPAD(0x894,PIN_OUTPUT_PULLDOWN | MUX_MODE7) 	*/		/* gpmc_oen_ren.gpio2_3 	P8_8*/
			/* AM33XX_IOPAD(0x894,PIN_OUTPUT_PULLDOWN | MUX_MODE7) 	*/		/* gpmc_oen_ren.gpio2_3 	P8_8*/
			/* AM33XX_IOPAD(0x890,PIN_INPUT_PULLDOWN | MUX_MODE7)	*/		/* gpmc_adv_ale.gpio2_2		P8_7*/
			/* AM33XX_IOPAD(0x894,PIN_OUTPUT_PULLDOWN | MUX_MODE7) 	*/		/* gpmc_oen_ren.gpio2_3 	P8_8*/
			/* AM33XX_IOPAD(0x890,PIN_INPUT_PULLDOWN | MUX_MODE7)	*/		/* gpmc_adv_ale.gpio2_2		P8_7*/
			/* AM33XX_IOPAD(0x894,PIN_OUTPUT_PULLDOWN | MUX_MODE7) 	*/		/* gpmc_oen_ren.gpio2_3 	P8_8*/
		>;
	};
	
	uart1_pins: uart1-pins {
		pinctrl-single,pins = <
			AM33XX_PADCONF(AM335X_PIN_UART1_RXD, PIN_INPUT_PULLUP, MUX_MODE0)
			AM33XX_PADCONF(AM335X_PIN_UART1_TXD, PIN_OUTPUT_PULLDOWN, MUX_MODE0)
		>;
	};
	
   	ehrpwm1_pins: ehrpwm1_pins {
       	pinctrl-single,pins = <
           		AM33XX_IOPAD(0x848, PIN_OUTPUT | MUX_MODE6) /* P9.14, EHRPWM1A */
           		AM33XX_IOPAD(0x84c, PIN_OUTPUT | MUX_MODE6) /* P9.16, EHRPWM1B */
       	>;
   	};
   	
   	ehrpwm2_pins: ehrpwm2_pins {
       	pinctrl-single,pins = <
     		AM33XX_IOPAD(0x820, PIN_OUTPUT | MUX_MODE4) /* P8.19, EHRPWM2A */
     		AM33XX_IOPAD(0x824, PIN_OUTPUT | MUX_MODE4) /* P8.13, EHRPWM2B */
    	>;
    };	
    	     	
    spi1_pins: spi1_pins {
		pinctrl-single,pins = <
			0x190 0x33	/* mcasp0_aclkx.spi1_sclk, INPUT_PULLUP | MODE3 */
			0x194 0x33	/* mcasp0_fsx.spi1_d0, INPUT_PULLUP | MODE3 */
			0x198 0x13	/* mcasp0_axr0.spi1_d1, OUTPUT_PULLUP | MODE3 */
			0x19c 0x13	/* mcasp0_ahclkr.spi1_cs0, OUTPUT_PULLUP | MODE3 */
			AM33XX_IOPAD(0x81C,PIN_OUTPUT_PULLDOWN | MUX_MODE7)	/* gpmc_ad4.gpio1_4 		P8_4*/
		>;
	};

};

&spi1 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi1_pins>;
	status = "okay";
	spi-max-frequency = <16000000>;
	st9776s: spi@0{
		compatible = "display,display_st9776s";		
		reg = <0>;
		spi-cpha;
		command-gpios=<&gpio1 7 GPIO_ACTIVE_LOW>; /* See gpio datasheet pinout mode 7 */
	};
};

&i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_pins>;

	status = "okay";
	clock-frequency = <400000>;
	
	mlx90640: infrared_sensor@33{
		compatible = "mlx90640,infrared_image";
		reg = <0x33>;
	};

	lidar: lidar_measurement@10{
		compatible = "lidar,measure_distance";
		reg = <0x10>;
	};

	ov7670: image_sensor@21{
		compatible = "ov7670,image_sensor";
		reg = <0x21>;		
		pclk-gpios	=<&gpio2 6 GPIO_ACTIVE_LOW>;
		hsync-gpios	=<&gpio2 8 GPIO_ACTIVE_LOW>;
		vsync-gpios	=<&gpio2 10 GPIO_ACTIVE_LOW>;
	};

};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_pins>;
	status = "okay";
	
	serialuc: comm_uc{
		compatible = "serialuc,microcontroller";
	};
};

&epwmss1 {
	status = "okay";
};

&ehrpwm1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&ehrpwm1_pins>;
};

&epwmss2 {
	status = "okay";
};

&ehrpwm2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&ehrpwm2_pins>;
};